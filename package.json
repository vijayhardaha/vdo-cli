{
  "name": "@vijayhardaha/vdo-cli",
  "version": "1.0.7",
  "description": "A Node.js CLI tool for video utilities using yt-dlp and ffmpeg",
  "type": "module",
  "main": "./dist/vdo.js",
  "exports": {
    ".": {
      "import": "./dist/vdo.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vdo": "dist/vdo.js"
  },
  "homepage": "https://github.com/vijayhardaha/vdo-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vijayhardaha/vdo-cli.git"
  },
  "bugs": {
    "url": "https://github.com/vijayhardaha/vdo-cli/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check --log-level error .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsc --noEmit",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "prepare": "husky"
  },
  "keywords": [
    "video",
    "cli",
    "ffmpeg",
    "yt-dlp",
    "download",
    "convert",
    "compress",
    "audio",
    "extract"
  ],
  "author": {
    "name": "Vijay Hardaha",
    "url": "https://github.com/vijayhardaha"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "yoctocolors": "^2.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.2.0",
    "@vijayhardaha/dev-config": "^2.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver"
  ]
}
